{
	"name": "my-github-page",
	"version": "0.0.0-semantically-released",
	"description": "My home page",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": ">=9"
	},
	"dependencies": {
		"date-fns": "4.1.0",
		"highlight.js": "11.11.1",
		"js-cookie": "3.0.5",
		"marked": "16.2.1",
		"marked-highlight": "2.2.2",
		"metascraper": "5.49.1",
		"metascraper-author": "5.49.1",
		"metascraper-date": "5.49.1",
		"metascraper-description": "5.49.1",
		"metascraper-image": "5.49.1",
		"metascraper-logo": "5.49.1",
		"metascraper-publisher": "5.49.1",
		"metascraper-title": "5.49.1",
		"metascraper-url": "5.49.1",
		"parse-md": "3.0.3",
		"zod": "4.1.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.1",
		"@eslint/js": "9.35.0",
		"@sveltejs/adapter-node": "5.3.1",
		"@sveltejs/adapter-static": "3.0.9",
		"@sveltejs/kit": "2.37.0",
		"@sveltejs/vite-plugin-svelte": "6.1.4",
		"@tsconfig/svelte": "5.0.5",
		"@types/js-cookie": "3.0.6",
		"@types/node": "24.3.1",
		"@types/slug": "5.0.9",
		"cross-spawn": "7.0.6",
		"eslint": "9.35.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.12.1",
		"lint-staged": "16.1.6",
		"postcss": "8.5.6",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.4.0",
		"sass": "1.92.0",
		"semantic-release": "24.2.7",
		"slug": "11.0.0",
		"svelte": "5.38.7",
		"svelte-check": "4.3.1",
		"svelte-eslint-parser": "1.3.1",
		"tslib": "2.8.1",
		"typescript": "5.9.2",
		"typescript-eslint": "8.42.0",
		"vite": "7.1.11",
        "vite-plugin-devtools-json": "1.0.0"
	},
	"scripts": {
		"meta": "node src/ci/links.ts",
		"meta:dev": "node --env-file .env src/ci/links.ts",
		"version": "node src/ci/version.ts",
		"format": "prettier --write ./**/*.svelte && prettier --write .",
		"format:check": "prettier --plugin-search-dir --check .",
		"lint": "eslint .",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"preview": "vite preview",
		"server": "node dist",
		"prepare": "svelte-kit sync",
		"draft": "node src/ci/create-md.ts",
		"welcome": "node src/ci/welcome.ts",
		"start": "pnpm run welcome && pnpm run server"
	},
	"type": "module",
	"keywords": [
		"svelte",
		"typescript",
		"webpack",
		"sass"
	],
	"author": "Sergey Nikitin <srg.post@gmail.com>",
	"license": "MIT",
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*.{md,yml,scss,css,svelte}": [
			"pnpm format"
		],
		"*.{js,jsx,ts,tsx}": [
			"pnpm format",
			"pnpm lint"
		]
	}
}
