{
	"name": "my-github-page",
	"version": "0.0.0-semantically-released",
	"description": "My home page",
	"engines": {
		"node": ">=24.14.1",
		"pnpm": ">=10"
	},
	"dependencies": {
		"date-fns": "4.1.0",
		"highlight.js": "11.11.1",
		"js-cookie": "3.0.5",
		"marked": "18.0.0",
		"marked-highlight": "2.2.4",
		"metascraper": "5.50.0",
		"metascraper-author": "5.50.0",
		"metascraper-date": "5.50.0",
		"metascraper-description": "5.50.0",
		"metascraper-image": "5.50.0",
		"metascraper-logo": "5.50.0",
		"metascraper-publisher": "5.50.0",
		"metascraper-title": "5.50.0",
		"metascraper-url": "5.50.0",
		"parse-md": "3.0.3",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.5",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-node": "5.5.4",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.57.0",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@tsconfig/svelte": "5.0.8",
		"@types/js-cookie": "3.0.6",
		"@types/node": "25.5.2",
		"@types/slug": "5.0.9",
		"cross-spawn": "7.0.6",
		"eslint": "10.2.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.17.0",
		"lint-staged": "16.4.0",
		"postcss": "8.5.9",
		"prettier": "3.8.1",
		"prettier-plugin-svelte": "3.5.1",
		"sass": "1.99.0",
		"semantic-release": "25.0.3",
		"slug": "11.0.1",
		"svelte": "5.55.2",
		"svelte-check": "4.4.6",
		"svelte-eslint-parser": "1.6.0",
		"tslib": "2.8.1",
		"typescript": "6.0.2",
		"typescript-eslint": "8.58.1",
		"vite": "8.0.7",
        "vite-plugin-devtools-json": "1.0.0"
	},
	"scripts": {
		"meta": "node src/ci/links.ts",
		"meta:dev": "node --env-file .env src/ci/links.ts",
		"version": "node src/ci/version.ts",
		"format": "prettier --write ./**/*.svelte && prettier --write .",
		"format:check": "prettier --plugin-search-dir --check .",
		"lint": "eslint .",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"preview": "vite preview",
		"server": "node dist",
		"prepare": "svelte-kit sync",
		"draft": "node src/ci/create-md.ts",
		"welcome": "node src/ci/welcome.ts",
		"start": "pnpm run welcome && pnpm run server"
	},
	"type": "module",
	"keywords": [
		"svelte",
		"typescript",
		"webpack",
		"sass"
	],
	"author": "Sergey Nikitin <srg.post@gmail.com>",
	"license": "MIT",
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*.{md,yml,scss,css,svelte}": [
			"pnpm format"
		],
		"*.{js,jsx,ts,tsx}": [
			"pnpm format",
			"pnpm lint"
		]
	}
}
